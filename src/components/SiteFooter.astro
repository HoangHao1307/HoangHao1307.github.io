---
import { resolvePath } from '../utils/path';
import SkullDecal from './SkullDecal.astro';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Red glow top border -->
  <div class="footer-glow-bar" aria-hidden="true"></div>

  <div class="container footer-container">
    <!-- Skull row above brand -->
    <div class="footer-skull-row" aria-hidden="true">
      {Array.from({ length: 5 }).map(() => (
        <SkullDecal size={44} />
      ))}
      <div class="skull-hr"></div>
      {Array.from({ length: 5 }).map(() => (
        <SkullDecal size={44} />
      ))}
    </div>
    <div class="footer-top-row">
      <div class="footer-brand">
        <div class="brand-badge">
          <span class="catalog-stamp">[ UNDERGROUND // SLAM ARCHIVE ]</span>
        </div>
        <p class="brand-tagline">
          Zine aesthetics, high contrast brutalism, and sonic heaviness. Built with Astro, TypeScript & Pure CSS.
        </p>
      </div>

      <div class="footer-actions">
        <button type="button" class="btn btn-back-to-top" id="back-to-top-btn" aria-label="Scroll back to top">
          <span class="btn-icon">▲</span> BACK TO TOP
        </button>
      </div>
    </div>

    <div class="footer-grid">
      <div class="footer-col">
        <h4 class="col-title">NAVIGATION</h4>
        <ul class="col-list">
          <li><a href={resolvePath('/')}>:: HOME</a></li>
          <li><a href={resolvePath('/about/')}>:: ABOUT & MANIFESTO</a></li>
          <li><a href={resolvePath('/projects/')}>:: WORKS & COMMISSIONS</a></li>
          <li><a href={resolvePath('/posts/')}>:: WRITINGS & ARCHIVE</a></li>
          <li><a href={resolvePath('/contact/')}>:: TRANSMISSION / CONTACT</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="col-title">CHANNELS [PLACEHOLDERS]</h4>
        <ul class="col-list">
          <li>
            <a href="https://github.com/example" target="_blank" rel="noopener noreferrer">
              :: GITHUB ↗
            </a>
          </li>
          <li>
            <a href="https://bandcamp.com" target="_blank" rel="noopener noreferrer">
              :: BANDCAMP ↗
            </a>
          </li>
          <li>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer">
              :: INSTAGRAM ↗
            </a>
          </li>
          <li>
            <a href="mailto:contact@example.com">
              :: DIRECT MAIL ↗
            </a>
          </li>
        </ul>
      </div>

      <div class="footer-col system-col">
        <h4 class="col-title">SPECIFICATION</h4>
        <div class="system-box">
          <div class="spec-row">
            <span class="spec-key">ENGINE:</span>
            <span class="spec-val">ASTRO STATIC</span>
          </div>
          <div class="spec-row">
            <span class="spec-key">THEME:</span>
            <span class="spec-val">HARDCORE SLAM</span>
          </div>
          <div class="spec-row">
            <span class="spec-key">HOSTING:</span>
            <span class="spec-val">GITHUB PAGES</span>
          </div>
          <div class="spec-row">
            <span class="spec-key">STATUS:</span>
            <span class="spec-val text-red">COMPILED OK</span>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom-bar">
      <div class="barcode-strip" aria-hidden="true">
        |||| | ||||| ||| || |||||| | |||| ||| |||||||
      </div>
      <div class="copyright-text">
        <span>© {currentYear} SLAM_PORTFOLIO.</span>
        <span class="disclaimer">ALL PLACEHOLDERS READY FOR USER CUSTOMIZATION.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 2px solid var(--color-border);
    background-color: #070707;
    padding-top: 0;
    padding-bottom: 2rem;
    position: relative;
    z-index: 10;
  }

  .footer-glow-bar {
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    box-shadow: 0 0 12px var(--color-accent-glow), 0 0 30px rgba(215,25,32,0.2);
  }

  .footer-skull-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px dashed var(--color-border);
    overflow: hidden;
  }

  .skull-hr {
    flex: 1;
    height: 1px;
    background: repeating-linear-gradient(
      90deg,
      transparent,
      transparent 4px,
      var(--color-border) 4px,
      var(--color-border) 8px
    );
    max-width: 200px;
  }

  .footer-container {
    padding-top: 3rem;
  }

  .footer-top-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .footer-top-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .brand-badge {
    margin-bottom: 0.5rem;
  }

  .brand-tagline {
    font-size: 0.9rem;
    max-width: 500px;
    color: var(--color-text-muted);
  }

  .btn-back-to-top {
    font-size: 0.75rem;
    padding: 0.6rem 1.2rem;
  }

  .btn-icon {
    color: var(--color-accent);
    font-size: 0.75rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: 1.2fr 1.2fr 1fr;
    }
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text);
    margin-bottom: 1rem;
    letter-spacing: 0.12em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .col-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .col-list a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-block;
  }

  .col-list a:hover {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .system-box {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.05);
    padding-bottom: 0.25rem;
  }

  .spec-key {
    color: var(--color-text-dim);
  }

  .spec-val {
    color: var(--color-text);
    font-weight: 700;
  }

  .text-red {
    color: var(--color-accent);
  }

  .footer-bottom-bar {
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .copyright-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-dim);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  @media (min-width: 640px) {
    .copyright-text {
      text-align: right;
    }
  }

  .disclaimer {
    color: var(--color-accent);
    font-size: 0.65rem;
  }
</style>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top-btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  setupBackToTop();
  document.addEventListener('astro:after-swap', setupBackToTop);
</script>
