---
import { resolvePath } from '../utils/path';
import { formatDate } from '../utils/date';
import Tag from './Tag.astro';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
      draft?: boolean;
    };
    body?: string;
  };
  readingTime?: string;
  index?: number;
}

const { post, readingTime = '3 min read', index = 0 } = Astro.props;
const formattedIndex = String(index + 1).padStart(2, '0');
const postUrl = resolvePath(`/posts/${post.id}/`);
---

<article class="post-card reveal-on-scroll">
  <div class="card-meta">
    <div class="meta-left">
      <span class="catalog-stamp">ENTRY #{formattedIndex}</span>
      <span class="meta-dot">·</span>
      <time datetime={post.data.pubDate.toISOString()} class="post-date">
        {formatDate(post.data.pubDate)}
      </time>
    </div>
    <div class="meta-right">
      <span class="post-reading-time">{readingTime}</span>
      {post.data.draft && (
        <span class="draft-pill">DRAFT</span>
      )}
    </div>
  </div>

  <h3 class="card-title">
    <a href={postUrl} class="title-link">
      {post.data.title}
    </a>
  </h3>

  <p class="card-description">
    {post.data.description}
  </p>

  <div class="card-footer">
    <div class="card-tags">
      {post.data.tags.slice(0, 3).map((tag: string) => (
        <Tag tag={tag} />
      ))}
    </div>

    <a href={postUrl} class="read-more-link" aria-label={`Read article: ${post.data.title}`}>
      OPEN ARCHIVE <span class="arrow-glyph">→</span>
    </a>
  </div>
</article>

<style>
  .post-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 1.75rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .post-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 0;
    background: var(--color-accent);
    transition: height var(--transition-fast);
  }

  .post-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
    box-shadow: 4px 4px 0 var(--color-accent), 0 0 20px rgba(215, 25, 32, 0.2);
  }

  .post-card:hover::before {
    height: 100%;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border-bottom: 1px dashed var(--color-border);
    padding-bottom: 0.75rem;
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .meta-dot {
    color: var(--color-text-dim);
  }

  .post-date {
    color: var(--color-text-muted);
  }

  .post-reading-time {
    color: var(--color-text-dim);
  }

  .draft-pill {
    background: var(--color-accent);
    color: #fff;
    padding: 0.1rem 0.4rem;
    font-size: 0.65rem;
    font-weight: 700;
  }

  .card-title {
    font-size: 1.6rem;
    line-height: 1.1;
  }

  .title-link {
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .title-link:hover {
    color: var(--color-accent);
  }

  .card-description {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
  }

  @media (min-width: 520px) {
    .card-footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .read-more-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    letter-spacing: 0.08em;
  }

  .read-more-link:hover {
    color: var(--color-accent);
  }

  .arrow-glyph {
    color: var(--color-accent);
    transition: transform var(--transition-fast);
  }

  .post-card:hover .arrow-glyph {
    transform: translateX(4px);
  }
</style>
