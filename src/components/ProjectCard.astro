---
import { resolvePath } from '../utils/path';

interface Props {
  project: {
    id: string;
    data: {
      title: string;
      description: string;
      year: string | number;
      role: string;
      tools: string[];
      featured?: boolean;
      link?: string;
      repo?: string;
    };
  };
  index?: number;
}

const { project, index = 0 } = Astro.props;
const formattedIndex = String(index + 1).padStart(2, '0');
const projectUrl = resolvePath(`/projects/${project.id}/`);
---

<div class="project-card bracket-box reveal-on-scroll">
  <div class="project-header">
    <div class="header-stamp">
      <span class="catalog-stamp">CASE #{formattedIndex}</span>
      <span class="divider">/</span>
      <span class="year-badge">[{project.data.year}]</span>
    </div>
    {project.data.featured && (
      <span class="featured-badge">FEATURED</span>
    )}
  </div>

  <h3 class="project-title">
    <a href={projectUrl} class="title-link">
      {project.data.title}
    </a>
  </h3>

  <p class="project-role">
    <span class="role-label">ROLE:</span> {project.data.role}
  </p>

  <p class="project-desc">
    {project.data.description}
  </p>

  <div class="project-tools">
    {project.data.tools.map((tool: string) => (
      <span class="tool-tag">{tool}</span>
    ))}
  </div>

  <div class="project-actions">
    <a href={projectUrl} class="btn btn-sm">
      VIEW CASE STUDY ↗
    </a>
    {project.data.link && (
      <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="external-link">
        EXTERNAL ↗
      </a>
    )}
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .project-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
    box-shadow: 4px 4px 0 var(--color-accent), 0 0 20px rgba(215, 25, 32, 0.18);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--color-border);
    padding-bottom: 0.6rem;
  }

  .header-stamp {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .divider {
    color: var(--color-text-dim);
  }

  .year-badge {
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .featured-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    background: var(--color-accent);
    color: #fff;
    padding: 0.15rem 0.45rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .project-title {
    font-size: 1.8rem;
    line-height: 1.05;
  }

  .title-link {
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .title-link:hover {
    color: var(--color-accent);
  }

  .project-role {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .role-label {
    color: var(--color-accent);
    font-weight: 700;
  }

  .project-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    flex-grow: 1;
  }

  .project-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 0.5rem;
  }

  .tool-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
    color: var(--color-text-dim);
  }

  .project-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
  }

  .btn-sm {
    padding: 0.6rem 1.1rem;
    font-size: 0.75rem;
  }

  .external-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .external-link:hover {
    color: var(--color-accent);
  }
</style>
