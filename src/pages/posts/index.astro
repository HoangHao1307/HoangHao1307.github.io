---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PostCard from '../../components/PostCard.astro';
import Tag from '../../components/Tag.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';

const isDev = import.meta.env.DEV;
const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((post) => isDev || !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Collect all unique tags and counts
const tagCounts = new Map<string, number>();
posts.forEach((post) => {
  post.data.tags.forEach((t: string) => {
    tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
  });
});
const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="ARCHIVE LOGS & POSTS" description="Toàn bộ bài viết, phân tích kỹ thuật âm thanh, typography underground và cẩm nang zine.">
  <div class="posts-index-page">
    <div class="container">
      <SectionHeading 
        tag="REPOSITORY // ARCHIVES" 
        title="TRANSMISSIONS & LOGS" 
        subtitle="Tuyển tập bài viết Markdown về kỹ thuật âm thanh, fanzine DIY và thiết kế brutalist."
      />

      <!-- Search and Filter Bar -->
      <div class="archive-controls bracket-box">
        <div class="search-input-wrap">
          <label for="post-search" class="search-label">
            <span class="catalog-stamp">SEARCH ARCHIVE:</span>
          </label>
          <div class="input-container">
            <span class="prompt-symbol">></span>
            <input 
              type="text" 
              id="post-search" 
              class="post-search-input" 
              placeholder="Nhập tiêu đề hoặc từ khóa tìm kiếm..." 
              autocomplete="off"
            />
          </div>
        </div>

        <div class="tags-filter-wrap">
          <span class="tags-filter-title">FILTER BY TAG:</span>
          <div class="tags-pill-list">
            <button type="button" class="tag-filter-btn active" data-tag="all">
              ALL ({posts.length})
            </button>
            {sortedTags.map(([tag, count]) => (
              <button type="button" class="tag-filter-btn" data-tag={tag}>
                #{tag} ({count})
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Post List Container -->
      <div class="posts-list-wrap" id="posts-container">
        {posts.map((post, index) => (
          <div 
            class="post-item-wrapper" 
            data-title={post.data.title.toLowerCase()} 
            data-desc={post.data.description.toLowerCase()} 
            data-tags={JSON.stringify(post.data.tags)}
          >
            <PostCard 
              post={post} 
              index={index} 
              readingTime={getReadingTime(post.body || '')} 
            />
          </div>
        ))}
      </div>

      <!-- Empty State -->
      <div class="empty-state bracket-box" id="empty-state" hidden>
        <span class="catalog-stamp">[ NO MATCHING TRANSMISSION ]</span>
        <h3 class="empty-title">KHÔNG TÌM THẤY BÀI VIẾT PHÙ HỢP</h3>
        <p class="empty-desc">
          Thử tìm bằng từ khóa khác hoặc bấm nút "ALL" để hiển thị lại toàn bộ danh mục lưu trữ.
        </p>
        <button type="button" class="btn" id="reset-filter-btn">
          RESET SEARCH & FILTERS
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .posts-index-page {
    padding: 3rem 0 6rem;
  }

  .archive-controls {
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.75rem;
  }

  .search-input-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .search-label {
    font-family: var(--font-mono);
  }

  .input-container {
    display: flex;
    align-items: center;
    background: #080808;
    border: 1px solid var(--color-border-strong);
    padding: 0.5rem 1rem;
    gap: 0.75rem;
  }

  .input-container:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .prompt-symbol {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-weight: 700;
  }

  .post-search-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .post-search-input::placeholder {
    color: var(--color-text-dim);
  }

  .tags-filter-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
  }

  .tags-filter-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }

  .tags-pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-filter-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--color-surface);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .tag-filter-btn:hover {
    border-color: var(--color-accent);
    color: #fff;
  }

  .tag-filter-btn.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
    font-weight: 700;
  }

  .posts-list-wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .posts-list-wrap {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-list-wrap {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .empty-state[hidden] {
    display: none;
  }

  .empty-title {
    font-size: 2rem;
    color: var(--color-text);
  }

  .empty-desc {
    max-width: 480px;
    color: var(--color-text-muted);
  }
</style>

<script>
  function setupSearchAndFilter() {
    const searchInput = document.getElementById('post-search') as HTMLInputElement | null;
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
    const postItems = document.querySelectorAll<HTMLElement>('.post-item-wrapper');
    const emptyState = document.getElementById('empty-state');
    const resetBtn = document.getElementById('reset-filter-btn');

    if (!searchInput || postItems.length === 0) return;

    let currentTag = 'all';
    let searchQuery = '';

    function applyFilter() {
      let visibleCount = 0;

      postItems.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-desc') || '';
        const tags = JSON.parse(item.getAttribute('data-tags') || '[]');

        const matchesSearch = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery);
        const matchesTag = currentTag === 'all' || tags.includes(currentTag);

        if (matchesSearch && matchesTag) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.removeAttribute('hidden');
        } else {
          emptyState.setAttribute('hidden', '');
        }
      }
    }

    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilter();
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentTag = btn.getAttribute('data-tag') || 'all';
        applyFilter();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        currentTag = 'all';
        filterBtns.forEach((b) => {
          if (b.getAttribute('data-tag') === 'all') {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });
        applyFilter();
      });
    }
  }

  setupSearchAndFilter();
  document.addEventListener('astro:after-swap', setupSearchAndFilter);
</script>
