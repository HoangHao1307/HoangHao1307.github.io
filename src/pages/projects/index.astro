---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Extract unique tools
const allTools = Array.from(new Set(allProjects.flatMap((p) => p.data.tools)));
---

<BaseLayout title="WORKS & COMMISSIONS" description="Danh mục các dự án thiết kế album art, ấn phẩm in lụa zine và giao diện brutalist.">
  <div class="projects-page">
    <div class="container">
      <SectionHeading 
        tag="PORTFOLIO // CASE REPOSITORY" 
        title="SELECTED COMMISSIONS" 
        subtitle="Tổng hợp các sản phẩm thị giác, bìa đĩa CD/Cassette, typography fanzine và ứng dụng web."
      />

      <!-- Filter by Tool / Discipline -->
      <div class="projects-filter-bar bracket-box">
        <span class="catalog-stamp">DISCIPLINE FILTER:</span>
        <div class="filter-pills" id="project-filters">
          <button type="button" class="tool-filter-btn active" data-tool="all">
            ALL DISCOGRAPHY & ART ({sortedProjects.length})
          </button>
          {allTools.map((tool) => (
            <button type="button" class="tool-filter-btn" data-tool={tool.toLowerCase()}>
              {tool}
            </button>
          ))}
        </div>
      </div>

      <!-- Projects Grid -->
      <div class="projects-grid" id="projects-grid">
        {sortedProjects.map((project, index) => (
          <div class="project-item-wrap" data-tools={JSON.stringify(project.data.tools.map((t: string) => t.toLowerCase()))}>
            <ProjectCard project={project} index={index} />
          </div>
        ))}
      </div>

      <!-- Empty Filter State -->
      <div class="empty-state bracket-box" id="project-empty-state" hidden>
        <span class="catalog-stamp">[ NO PROJECTS MATCHED ]</span>
        <h3 class="empty-title">KHÔNG CÓ DỰ ÁN NÀO TRÙNG KHỚP</h3>
        <p class="empty-desc">Vui lòng chọn bộ lọc khác để xem danh sách tác phẩm.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .projects-page {
    padding: 3rem 0 6rem;
  }

  .projects-filter-bar {
    margin-bottom: 3rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tool-filter-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--color-surface);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .tool-filter-btn:hover {
    border-color: var(--color-accent);
    color: #fff;
  }

  .tool-filter-btn.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
    font-weight: 700;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .empty-state[hidden] {
    display: none;
  }

  .empty-title {
    font-size: 2rem;
    color: var(--color-text);
  }

  .empty-desc {
    color: var(--color-text-muted);
  }
</style>

<script>
  function setupProjectFilters() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.tool-filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.project-item-wrap');
    const emptyState = document.getElementById('project-empty-state');

    if (items.length === 0 || filterBtns.length === 0) return;

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const selected = btn.getAttribute('data-tool') || 'all';
        let count = 0;

        items.forEach((item) => {
          const tools = JSON.parse(item.getAttribute('data-tools') || '[]');
          if (selected === 'all' || tools.includes(selected)) {
            item.style.display = 'block';
            count++;
          } else {
            item.style.display = 'none';
          }
        });

        if (emptyState) {
          if (count === 0) {
            emptyState.removeAttribute('hidden');
          } else {
            emptyState.setAttribute('hidden', '');
          }
        }
      });
    });
  }

  setupProjectFilters();
  document.addEventListener('astro:after-swap', setupProjectFilters);
</script>
