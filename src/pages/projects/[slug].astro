---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolvePath } from '../../utils/path';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sorted = projects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

  return sorted.map((project, index) => {
    const prevProject = index > 0 ? sorted[index - 1] : null;
    const nextProject = index < sorted.length - 1 ? sorted[index + 1] : null;

    return {
      params: { slug: project.id },
      props: { project, prevProject, nextProject },
    };
  });
}

const { project, prevProject, nextProject } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <div class="project-detail-page">
    <div class="content-container">
      <div class="back-nav">
        <a href={resolvePath('/projects/')} class="back-link">
          ← BACK TO WORKS CATALOG
        </a>
      </div>

      <!-- Project Hero Info -->
      <header class="project-header bracket-box">
        <div class="project-meta-top">
          <span class="catalog-stamp">[ CASE REF: {project.id} ]</span>
          <span class="year-badge">RELEASE // {project.data.year}</span>
        </div>

        <h1 class="project-title">{project.data.title}</h1>

        <p class="project-desc-lead">{project.data.description}</p>

        <div class="meta-specs-grid">
          <div class="spec-cell">
            <span class="spec-label">ASSIGNED ROLE:</span>
            <span class="spec-value">{project.data.role}</span>
          </div>
          <div class="spec-cell">
            <span class="spec-label">DISCIPLINES:</span>
            <div class="spec-tags">
              {project.data.tools.map((tool: string) => (
                <span class="tool-pill">{tool}</span>
              ))}
            </div>
          </div>
        </div>

        {(project.data.link || project.data.repo) && (
          <div class="project-links-row">
            {project.data.link && (
              <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                OPEN EXTERNAL WORK ↗
              </a>
            )}
            {project.data.repo && (
              <a href={project.data.repo} target="_blank" rel="noopener noreferrer" class="btn">
                VIEW SOURCE REPOSITORY ↗
              </a>
            )}
          </div>
        )}
      </header>

      <!-- Case Study Body -->
      <div class="case-study-body markdown-body">
        <Content />
      </div>

      <!-- Navigation Prev / Next -->
      <nav class="project-pagination-strip" aria-label="Projects pagination">
        {prevProject ? (
          <a href={resolvePath(`/projects/${prevProject.id}/`)} class="nav-prev">
            <span class="dir-text">← PREVIOUS CASE</span>
            <span class="item-title">{prevProject.data.title}</span>
          </a>
        ) : <div class="nav-placeholder"></div>}

        {nextProject ? (
          <a href={resolvePath(`/projects/${nextProject.id}/`)} class="nav-next">
            <span class="dir-text">NEXT CASE →</span>
            <span class="item-title">{nextProject.data.title}</span>
          </a>
        ) : <div class="nav-placeholder"></div>}
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .project-detail-page {
    padding: 3rem 0 6rem;
  }

  .back-nav {
    margin-bottom: 2rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .project-header {
    margin-bottom: 3.5rem;
    padding: 2.5rem 2rem;
  }

  .project-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--color-border);
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .year-badge {
    color: var(--color-text-dim);
  }

  .project-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .project-desc-lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .meta-specs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    border-top: 1px dashed var(--color-border);
    border-bottom: 1px dashed var(--color-border);
    padding: 1.5rem 0;
    margin-bottom: 2rem;
  }

  @media (min-width: 640px) {
    .meta-specs-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .spec-cell {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    font-weight: 700;
  }

  .spec-value {
    font-size: 1rem;
    color: var(--color-text);
  }

  .spec-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tool-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .project-links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Case study markdown styling */
  .case-study-body {
    margin-bottom: 4rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .case-study-body :global(h2) {
    font-size: 2rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .case-study-body :global(p) {
    margin-bottom: 1.5rem;
    color: #cfcac0;
  }

  .case-study-body :global(ul), .case-study-body :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: #cfcac0;
  }

  .case-study-body :global(li) {
    margin-bottom: 0.5rem;
  }

  /* Pagination */
  .project-pagination-strip {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    border-top: 2px solid var(--color-border);
    padding-top: 2rem;
  }

  @media (min-width: 640px) {
    .project-pagination-strip {
      grid-template-columns: 1fr 1fr;
    }
  }

  .nav-prev, .nav-next {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: all var(--transition-fast);
  }

  .nav-prev:hover, .nav-next:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-hover);
  }

  .nav-next {
    text-align: right;
  }

  .dir-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
    font-weight: 700;
  }

  .item-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-text);
  }
</style>
